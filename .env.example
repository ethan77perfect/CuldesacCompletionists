# Copy to .env for local development (vercel dev). On Vercel itself,
# set these in Project Settings -> Environment Variables instead.

# From https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-key-here

# From your Supabase project: Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# A password you make up. Anyone who knows it can add/remove
# games and members and save club rules. Share it with your friends.
CLUB_KEY=make-up-a-good-password

# --- v4: nightly snapshots ---
# Protects /api/cron from strangers. Make up a value; Vercel's scheduler
# sends it automatically, and you can test with /api/cron?secret=VALUE
CRON_SECRET=make-up-another-password

# Optional: Discord channel webhook for the morning digest
# (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=
